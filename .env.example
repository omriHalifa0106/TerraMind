# Copy to .env and fill in. Never commit .env.

# --- LLM: Anthropic API (directly, or through an Anthropic-compatible gateway via ANTHROPIC_BASE_URL) ---
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
LLM_TIMEOUT_S=45

# --- Observability (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=terramind-dev
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only for an EU-region account

# --- Road routing (docker compose `osrm`) and address lookup ---
OSRM_URL=http://localhost:5000

# --- Database ---
# TerraMind's container is published on host port 5433 (5432 is often taken by another PostgreSQL).
DATABASE_URL=postgresql://terramind:terramind@localhost:5433/terramind

# --- Embeddings: "bge" (needs `uv sync --extra embeddings`) or "hash" (offline, for tests only) ---
EMBEDDING_BACKEND=bge

# --- Local services ---
MOCK_ALERTS_URL=http://localhost:8200
MCP_GIS_URL=http://localhost:8101/mcp
MCP_KNOWLEDGE_URL=http://localhost:8102/mcp
MCP_WEATHER_URL=http://localhost:8103/mcp
MCP_ALERTS_URL=http://localhost:8104/mcp
